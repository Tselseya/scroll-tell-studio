# API server
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=../../data/scrolltell.db
APP_URL=http://127.0.0.1:8787
WEB_APP_URL=http://127.0.0.1:5173
WEB_ORIGIN=http://127.0.0.1:5173

# OAuth — create apps with callbacks /auth/github/callback and /auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI copilot — any OpenAI-compatible provider endpoint
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-5-mini

# Direct Claude selection in the editor
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-sonnet-4-6

# Manus is connected as an MCP/agent integration, not a chat-completions model
# Set this only when documenting or checking a deployed MCP endpoint.
MANUS_MCP_URL=

# Local media vault (use a mounted persistent path in production)
MEDIA_DIR=../../data/media

# Optional bearer token for Streamable HTTP MCP requests
MCP_AUTH_TOKEN=

# Frontend when hosted separately
# VITE_API_URL=https://api.example.com

# Railway example: DATABASE_URL=/app/data/scrolltell.db
# Render example:  DATABASE_URL=/var/data/scrolltell.db
